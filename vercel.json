{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/offline.html",
      "destination": "/offline"
    }
  ],
  "routes": [
    {
      "src": "/index.xml",
      "status": 301,
      "headers": {
        "Location": "/sitemap.rss"
      }
    },
    {
      "src": "/sitemap.rss",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!offline).*[^/])$",
      "status": 301,
      "headers": {
        "Location": "/$1/"
      }
    },
    {
      "src": "/(.*)",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    }
  ],
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
